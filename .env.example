# Copy to .env and leave this file as the template. .env is gitignored.
# Compose reads .env automatically. Do not put real Neon credentials here.

# local: Postgres started by Compose, loaded with database.sql.
# neon: the SPRING_DATASOURCE_* variables below. The seed is not applied.
DB_TARGET=local

# Password of the Compose Postgres service. Used only when DB_TARGET=local.
LOCAL_DB_USERNAME=cocos
LOCAL_DB_PASSWORD=cocos

# Uncomment for DB_TARGET=neon. JDBC URL, user and password stay separate.
# The URL must include sslmode=require and must not contain the user or the password.
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
